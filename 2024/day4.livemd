## Part1

```elixir
defmodule Day4 do

  def check_lines(point, map) do
    point
    |> get_lines(map)
    |> Enum.filter(fn row -> row == "MAS" end)
    |> Enum.count()
  end
  
  def get_lines(point, map) do
    [
      up(point),
      down(point),
      right(point),
      left(point),
      up_right(point),
      down_left(point),
      up_left(point),
      down_right(point)
    ]
    |> Enum.map(&to_lines(&1, map))
  end

  def up({{x, y}, _v}) do
    [
      {x - 1, y},
      {x - 2, y},
      {x - 3, y}
    ]
  end

  def down({{x, y}, _v}) do
    [
      {x + 1, y},
      {x + 2, y},
      {x + 3, y}
    ]
  end

  def right({{x, y}, _v}) do
    [
      {x, y + 1},
      {x, y + 2},
      {x, y + 3}
    ]
  end

  def left({{x, y}, _v}) do
    [
      {x, y - 1},
      {x, y - 2},
      {x, y - 3}
    ]
  end

  def up_right({{x, y}, _v}) do
    [
      {x - 1, y + 1},
      {x - 2, y + 2},
      {x - 3, y + 3}
    ]
  end

  def down_left({{x, y}, _v}) do
    [
      {x + 1, y - 1},
      {x + 2, y - 2},
      {x + 3, y - 3}
    ]
  end

  def up_left({{x, y}, _v}) do
    [
      {x - 1, y - 1},
      {x - 2, y - 2},
      {x - 3, y - 3}
    ]
  end

  def down_right({{x, y}, _v}) do
    [
      {x + 1, y + 1},
      {x + 2, y + 2},
      {x + 3, y + 3}
    ]
  end

  def to_lines(point_list, map) do
    point_list
    |> Enum.map(&Map.get(map, &1))
    |> Enum.join("")
  end
end

cmap =
  data
  |> String.split("\n", trim: true)
  |> Enum.map(&String.split(&1, "", trim: true))
  |> Ndim.to_coordinate_map()

cmap
|> Enum.filter(fn {_k, v} -> v == "X" end)
|> Enum.map(&Day4.check_lines(&1, cmap))
|> Enum.sum()
```
